{
  "name": "@kahme247/ompweb",
  "version": "0.6.0",
  "description": "Framework-free omp client core, Bun host and minimal HTTP API",
  "homepage": "https://github.com/kahme247/ompweb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahme247/ompweb.git"
  },
  "bugs": {
    "url": "https://github.com/kahme247/ompweb/issues"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "start": "bun server/index.ts",
    "dev": "bun --watch server/index.ts",
    "contract": "bun scripts/generate-openapi.ts",
    "contract:check": "bun scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "mammoth": "^1.12.2",
    "node-pty": "^1.1.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "yaml": "^2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/web-push": "^3.6.4",
    "typescript": "^5"
  },
  "files": [
    "core",
    "lib",
    "server",
    "contract",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./core/index.ts",
    "./core": "./core/index.ts",
    "./lib/*": "./lib/*.ts"
  },
  "type": "module",
  "trustedDependencies": [
    "node-pty"
  ]
}
